# VPS Deployment Configuration
# Copy this to .env and fill in your values (do not commit .env)

# Container Registry
REGISTRY_URL=
REGISTRY_USER=
REGISTRY_PASSWORD=

# Network Configuration
DNS_SERVERS=1.1.1.1,8.8.8.8
NTP_SERVERS=time.cloudflare.com

# Service Accounts
SERVICE_USER=podlet-svc
SERVICE_GROUP=podlet-svc

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_DEBUG=false

# MCP Server
MCP_SOCKET_PATH=/run/mcp-filesystem.sock
MCP_CONFIG_FILE=/srv/sjl/config/hardened-mcp-config.json
